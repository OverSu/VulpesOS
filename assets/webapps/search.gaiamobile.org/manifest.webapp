      "description": "Gaia 系統網頁瀏覽器"
    }
  },
  "default_locale": "en-US",
  "permissions": {
    "themeable": {},
    "mobileconnection": {},
    "webapps-manage": {},
    "open-remote-window": {},
    "settings": {
      "access": "readwrite"
    },
    "systemXHR": {},
    "contacts": {
      "access": "readonly"
    },
    "moz-extremely-unstable-and-will-change-webcomponents": {}
  },
  "connections": {
    "search": {
      "handler_path": "index.html",
      "description": "Notifies the search app on query change.",
      "rules": {}
    }
  },
  "datastores-access": {
    "places": {
      "access": "readonly",
      "description": "Stores data about browsing history."
    },
    "bookmarks_store": {
      "access": "readonly",
      "description": "Stores data about bookmarks"
    }
  },
  "icons": {
    "284": "/shared/resources/branding/vulpes-browser.png"
  },
  "chrome": {
    "navigation": true
  },
  "activities": {
    "search": {
      "filters": {
        "type": "text/plain",
        "keyword": {
          "required": true
        }
      },
      "disposition": "window",
      "href": "/index.html"
    }
  },
  "origin": "app://search.gaiamobile.org",
  "version": "2.5"
}
