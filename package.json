{
  "name": "vulpes-maintenance",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "format": "prettier --write 'host/**/*.{js,mjs,css}' 'services/*.mjs' 'adapters/*.mjs' 'tests/*.mjs' 'android/{extension,ui,tests}/**/*.{js,mjs}' 'android/app/src/main/java/**/*.java'",
    "format:check": "prettier --check 'host/**/*.{js,mjs,css}' 'services/*.mjs' 'adapters/*.mjs' 'tests/*.mjs' 'android/{extension,ui,tests}/**/*.{js,mjs}' 'android/app/src/main/java/**/*.java'"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "prettier-plugin-java": "2.7.7"
  }
}
